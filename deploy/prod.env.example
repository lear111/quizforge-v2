# 生产环境变量模板：只有变量名与说明，不写任何值。
# 复制到服务器 /etc/quizforge/prod.env，权限 600（chown root:root）。不要提交到仓库。
# 启动时会检查：缺失、过短或仍是示例值都拒绝启动，日志写明缺哪一项（不打印值）。
# 生成随机值：openssl rand -hex 32；AI 主密钥：openssl rand -base64 32

# ---- 站点 ----
# 公开地址，必须是 https，不带路径。已发布客户端写死为 https://quizforge.treenewbee.cloud
QF_PUBLIC_ORIGIN=
# Nginx 的 server_name，与上面的域名相同
QF_SERVER_NAME=

# ---- 证书（docs/ops/01-deploy.md 第 3 节）----
# 宿主机上的证书目录，只读挂载到容器
QF_TLS_DIR=
# 目录内证书链与私钥的相对路径
QF_TLS_CERT=
QF_TLS_KEY=
# Let's Encrypt HTTP-01 验证的 webroot（宿主机目录）；自备证书可不设
QF_ACME_DIR=

# ---- 数据库 ----
# 应用账号密码（至少 16 个字符）
QF_DB_PASSWORD=
# root 密码（备份与恢复脚本使用）
QF_DB_ROOT_PASSWORD=

# ---- 内部令牌 ----
# app 与 rule-runner 之间的令牌（至少 32 个字符）
QF_RULE_RUNNER_TOKEN=

# ---- 验证码摘要密钥（至少 32 个字符；重新生成即可，旧验证码不迁移）----
QF_EMAIL_CODE_PEPPER=
QF_SMS_CODE_PEPPER=

# ---- 兑换码与上游 Key 的加密密钥（32 字节的 Base64）----
# 丢失后已保存的兑换码与上游 Key 无法解密：要和备份分开保存一份。
QF_AI_MASTER_KEY=

# ---- 邮件：腾讯云 SES（旧平台的配置抄到这里，变量名加 QF_ 前缀）----
QF_TENCENT_SES_ENABLED=true
QF_TENCENT_SECRET_ID=
QF_TENCENT_SECRET_KEY=
QF_TENCENT_SES_FROM=
QF_TENCENT_SES_TEMPLATE_ID=
QF_TENCENT_SES_REGION=

# ---- 短信：阿里云号码认证 ----
QF_ALIYUN_SMS_ENABLED=true
QF_ALIYUN_SMS_ACCESS_KEY_ID=
QF_ALIYUN_SMS_ACCESS_KEY_SECRET=
QF_ALIYUN_SMS_SIGN_NAME=
QF_ALIYUN_SMS_TEMPLATE_CODE=

# ---- 人机验证：Cloudflare Turnstile ----
QF_TURNSTILE_SITE_KEY=
QF_TURNSTILE_SECRET_KEY=

# ---- 大模型（可选，不设时使用 docker-compose.yml 的默认值；Key 在后台“AI 服务”中添加）----
# QF_AI_BASE_URL=
# QF_AI_MODEL=

# ---- 客户端安装包目录（宿主机，tools/downloads/README.md）----
QF_DOWNLOADS_DIR=

# ---- 监控（只在使用 docker-compose.monitoring.yml 时需要）----
# QF_MYSQL_EXPORTER_PASSWORD=
