{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "富文本简答题数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "material",
    "parts"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "material": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/document"
        }
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stem",
          "answerAndExplanation",
          "maxScore"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "stem": {
            "$ref": "#/definitions/document"
          },
          "answerAndExplanation": {
            "$ref": "#/definitions/document"
          },
          "maxScore": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "multipleOf": 0.5
          }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "doc",
            "paragraph",
            "heading",
            "blockquote",
            "bulletList",
            "orderedList",
            "listItem",
            "codeBlock",
            "hardBreak",
            "horizontalRule",
            "image",
            "text",
            "table",
            "tableRow",
            "tableCell",
            "tableHeader",
            "inlineMath",
            "blockMath"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "attrs": {
          "type": "object"
        },
        "marks": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bold",
                  "italic",
                  "strike",
                  "underline",
                  "code",
                  "link",
                  "textStyle",
                  "highlight",
                  "subscript",
                  "superscript"
                ]
              },
              "attrs": {
                "type": "object"
              }
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "document": {
      "allOf": [
        {
          "$ref": "#/definitions/node"
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "doc"
            },
            "content": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
