{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "按小问保存的富文本作答",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "responses"
  ],
  "properties": {
    "responses": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/document"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "doc",
            "paragraph",
            "heading",
            "blockquote",
            "bulletList",
            "orderedList",
            "listItem",
            "codeBlock",
            "hardBreak",
            "horizontalRule",
            "image",
            "text",
            "table",
            "tableRow",
            "tableCell",
            "tableHeader",
            "inlineMath",
            "blockMath"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "attrs": {
          "type": "object"
        },
        "marks": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bold",
                  "italic",
                  "strike",
                  "underline",
                  "code",
                  "link",
                  "textStyle",
                  "highlight",
                  "subscript",
                  "superscript"
                ]
              },
              "attrs": {
                "type": "object"
              }
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "document": {
      "allOf": [
        {
          "$ref": "#/definitions/node"
        },
        {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "doc"
            },
            "content": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
