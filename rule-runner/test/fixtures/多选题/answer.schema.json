{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "作答数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedOptionIds"
  ],
  "properties": {
    "selectedOptionIds": {
      "type": "array",
      "maxItems": 26,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    }
  }
}
