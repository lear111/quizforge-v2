# 容量复测用的一次性配置（loadtest/CAPACITY.md）。复制为 loadtest/capacity.env（已被 git 忽略），填入随机值。
# 不要使用正式的 prod.env：复测项目用自己的数据库与令牌，结束后整个删除。
# 生成：openssl rand -hex 32；AI 主密钥：openssl rand -base64 32
QF_PUBLIC_ORIGIN=http://localhost:8099
QF_HTTP_PORT=8099
QF_DB_PASSWORD=
QF_DB_ROOT_PASSWORD=
QF_RULE_RUNNER_TOKEN=
QF_EMAIL_CODE_PEPPER=
QF_SMS_CODE_PEPPER=
QF_AI_MASTER_KEY=
# docker-compose.prod.yml 要求这些变量存在；复测时 Nginx 使用 HTTP 开发配置，不读取证书。
QF_SERVER_NAME=localhost
QF_TLS_DIR=./nginx
QF_TLS_CERT=unused
QF_TLS_KEY=unused
